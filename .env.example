ANTHROPIC_API_KEY=

# Which image generator to use: local, leonardo, fal, gemini, higgsfield. See integrations/media/registry.py.
MEDIA_GENERATOR=local

# local: runs Stable Diffusion via `diffusers` on your own GPU/CPU — no per-image API credits,
# but lower quality on small/old models. HUGGINGFACE_TOKEN is only needed if the model repo
# requires accepting a license click-through (create a free account at huggingface.co, accept
# the license on the model page, generate a read token under Settings -> Access Tokens).
LOCAL_IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
MEDIA_DEVICE=cuda
HUGGINGFACE_TOKEN=

# leonardo: hosted API (cloud.leonardo.ai). NOTE: the 150 free credits/day are app-only — API
# usage needs credits purchased separately at https://app.leonardo.ai/api-access.
LEONARDO_API_KEY=
LEONARDO_MODEL_ID=de7d3faf-762f-48e0-b3b7-9d0ac3a3fcf3

# fal: hosted API (fal.ai), FLUX.1 [schnell] — ~$20 in free credits usable directly via API on
# signup, no purchase needed. Get a key at https://fal.ai/dashboard/keys.
FAL_API_KEY=

# gemini: hosted API (Google), gemini-2.5-flash-image aka "nano banana" — genuine free tier via
# API key, no card required (~500 images/day). The only backend here that can take a reference
# image (e.g. the real brand logo, see brand/logo_primary.png) and compose it into the result.
# Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL_ID=gemini-2.5-flash-image

# higgsfield: hosted API (higgsfield.ai), "Soul" model — noticeably higher image quality than
# the others above, paid credits only (no free tier). Get a key pair (id + secret) at
# https://higgsfield.ai/ -> API access.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_MODEL_ID=higgsfield-ai/soul/v2/standard

# Comma-separated list of platforms to publish to: facebook, mastodon.
# Only fill in the credentials for the ones listed here.
ENABLED_PLATFORMS=facebook

FB_GRAPH_API_VERSION=v21.0
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Mastodon: generate an access token instantly under Settings -> Development -> New Application
# (no app review needed). MASTODON_BASE_URL is your instance, e.g. https://mastodon.social
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
