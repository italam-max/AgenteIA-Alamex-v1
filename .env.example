ANTHROPIC_API_KEY=

# Which image generator to use: local, leonardo, fal, gemini, higgsfield. See integrations/media/registry.py.
MEDIA_GENERATOR=local

# local: runs Stable Diffusion via `diffusers` on your own GPU/CPU — no per-image API credits,
# but lower quality on small/old models. HUGGINGFACE_TOKEN is only needed if the model repo
# requires accepting a license click-through (create a free account at huggingface.co, accept
# the license on the model page, generate a read token under Settings -> Access Tokens).
LOCAL_IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
MEDIA_DEVICE=cuda
HUGGINGFACE_TOKEN=

# leonardo: hosted API (cloud.leonardo.ai). NOTE: the 150 free credits/day are app-only — API
# usage needs credits purchased separately at https://app.leonardo.ai/api-access.
LEONARDO_API_KEY=
LEONARDO_MODEL_ID=de7d3faf-762f-48e0-b3b7-9d0ac3a3fcf3

# fal: hosted API (fal.ai), FLUX.1 [schnell] — ~$20 in free credits usable directly via API on
# signup, no purchase needed. Get a key at https://fal.ai/dashboard/keys.
FAL_API_KEY=

# gemini: hosted API (Google), gemini-2.5-flash-image aka "nano banana". Paid credits only as of
# 2026-09 — Google removed the free tier for this image model (tested with 3 separate keys, all
# returned "generate_content_free_tier_requests limit: 0"; the free tier docs/claims elsewhere
# about this model are stale). One of the backends here that can take a reference image (e.g. the
# real brand logo, see brand/logo_primary.png) and compose it into the result. Get a key at
# https://aistudio.google.com/apikey and enable billing on the project to actually use it.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL_ID=gemini-2.5-flash-image

# higgsfield: hosted API (higgsfield.ai), "Soul" model — noticeably higher image quality than
# the others above, paid credits only (no free tier). Get a key pair (id + secret) at
# https://higgsfield.ai/ -> API access.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_MODEL_ID=higgsfield-ai/soul/v2/standard

# openai: hosted API (platform.openai.com), gpt-image-2 — very capable, paid credits only (no
# free tier). Supports a reference image (e.g. the real brand logo) like gemini does. Get a key
# at https://platform.openai.com/api-keys. (gpt-image-1, the previous default here, is retired by
# OpenAI on 2026-10-23 — gpt-image-2 is the official replacement, same endpoints, ~20-25% cheaper.)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL_ID=gpt-image-2

# Video posts (short vertical clips): a silent b-roll clip from VIDEO_GENERATOR below, narrated by
# OpenAI text-to-speech, muxed into one mp4 (see integrations/media/video_compositor.py). Requires
# the `ffmpeg` binary installed and on PATH — see README setup.
OPENAI_TTS_MODEL_ID=tts-1
OPENAI_TTS_VOICE=alloy

# Which video generator to use: siliconflow, gemini. See integrations/media/registry.py.
VIDEO_GENERATOR=siliconflow

# siliconflow: hosted API (siliconflow.com — note .com for international accounts, .cn rejects
# non-China keys), Wan2.2 text-to-video — cheap, supports 9:16 via image_size="720x1280". Get a
# key at https://cloud.siliconflow.com and add balance (pay-as-you-go, no free tier for video).
SILICONFLOW_API_KEY=
SILICONFLOW_VIDEO_MODEL_ID=Wan-AI/Wan2.2-T2V-A14B

# gemini: Google Veo 3.1 Fast via the Gemini API — reuses GEMINI_API_KEY above, no separate key
# needed. ~$0.10/s at 720p (no free tier). Supports 9:16 natively via aspectRatio param.
GEMINI_VIDEO_MODEL_ID=veo-3.1-fast-generate-preview

# higgsfield: NOT currently usable for video here — this account's Higgsfield plan only exposes
# their own Soul (image)/DoP (image-to-video)/Popcorn (image) models, not the third-party
# text-to-video ones (Kling/Seedance/Veo/Sora) advertised on higgsfield.ai's site/docs. DoP could
# work as a future image-to-video pipeline (generate a still frame, then animate it) but needs an
# image_url, not just a prompt — see integrations/media/higgsfield_video.py.
HIGGSFIELD_VIDEO_MODEL_ID=

# Comma-separated list of platforms to publish to: facebook, mastodon.
# Only fill in the credentials for the ones listed here.
ENABLED_PLATFORMS=facebook

FB_GRAPH_API_VERSION=v21.0
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Mastodon: generate an access token instantly under Settings -> Development -> New Application
# (no app review needed). MASTODON_BASE_URL is your instance, e.g. https://mastodon.social
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

# Growth mission (run_growth_mission.py) — an autonomous Mastodon-only experiment: posts,
# replies to mentions, and follows relevant accounts to work toward GROWTH_TARGET_FOLLOWERS. Use a
# SEPARATE TEST ACCOUNT's MASTODON_BASE_URL/MASTODON_ACCESS_TOKEN above, never the real brand
# account, while this is being tried out. The MAX_* caps exist specifically to reduce the risk of
# the account being flagged as spam/bot by Mastodon — start conservative.
GROWTH_TARGET_FOLLOWERS=100
GROWTH_TICK_MINUTES=60
GROWTH_MAX_FOLLOWS_PER_TICK=5
GROWTH_MAX_REPLIES_PER_TICK=5
# Comma-separated hashtags (no #) relevant to Alamex's niche, used to discover accounts to follow.
# The bigger this list, the more accounts get discovered per tick — go wide within the niche (both
# languages, synonyms, adjacent sub-topics), not generic/trending tags: search_accounts_by_hashtag
# only looks at who *posted* with the tag recently, so an off-topic tag surfaces off-topic accounts,
# which agents/prompts/growth_mission_system.md explicitly tells the agent not to follow anyway.
GROWTH_HASHTAGS=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
